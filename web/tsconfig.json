{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@cloudflare/privacypass-ts": ["./node_modules/@cloudflare/privacypass-ts"] }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts", "../sdk/src/core.ts"]
}
