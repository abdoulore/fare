# /etc/fare/site.env, mode 0644. Not secret: read by Caddy, every Fare service and setup.sh.
FARE_DOMAIN=fare.example.org
FARE_ACME_EMAIL=you@example.org
# Explorer link prefix for txids on /try and /proof. Empty means the default,
# https://testnet.zecblock.com/tx/ (it shows Ironwood transactions).
VITE_EXPLORER_TX=
