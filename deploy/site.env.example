# /etc/fare/site.env, mode 0644. Not secret: read by Caddy, every Fare service and setup.sh.
FARE_DOMAIN=fare.example.org
FARE_ACME_EMAIL=you@example.org
# Explorer link prefix for txids on /try and /proof, for example https://<explorer>/tx/
# Leave empty to show txids without links.
VITE_EXPLORER_TX=
